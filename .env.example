# 复制为 .env 后，把示例值替换为本地专用值。不要提交 .env。
WEB_PORT=8080
API_ADDR=:8081

DB_HOST=db
DB_PORT=3306
DB_NAME=campusclaw
DB_USER=campusclaw
DB_PASSWORD=replace-with-a-local-db-password

# 至少 32 个随机字符；用于签名不透明会话标识。
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_TTL_MINUTES=480

UPLOAD_DIR=/data/uploads
MAX_UPLOAD_BYTES=5242880
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_SECONDS=300

# 种子口令只从环境读取，数据库中仅保存 bcrypt 哈希。
SEED_TEACHER_A_PASSWORD=replace-teacher-a-password
SEED_STUDENT_A1_PASSWORD=replace-student-a1-password
SEED_STUDENT_B1_PASSWORD=replace-student-b1-password

# 服务端模型网关。嵌入请求会发送切片正文；问答请求只发送本班命中切片。
GATEWAY_BASE_URL=https://replace-with-approved-gateway.example/v1
GATEWAY_API_KEY=replace-with-gateway-key
EMBEDDING_MODEL=replace-with-pinned-embedding-model
CHAT_MODEL=replace-with-pinned-chat-model
EMBEDDING_DIMENSION=1024
INDEX_RETRY_MAX=5
INDEX_RETRY_SECONDS=5
